<Window x:Class="MillerColumns.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MillerColumns.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Icon="app.ico"
        Height="700" Width="1100"
        MinHeight="450" MinWidth="750"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Style for Miller Column ListBoxItem with Right-Click Protection & Drag Source -->
        <Style x:Key="ColumnListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnListBoxItemPreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnListBoxItemPreviewMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnListBoxItemPreviewMouseLeftButtonUp" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListBoxItemPreviewMouseRightButtonDown" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="OnListBoxItemPreviewMouseRightButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Sidebar ListBoxItem -->
        <Style x:Key="SidebarListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="3,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Edge-to-Edge Layout (No Top Path Bar) -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Favorites & Drives + Bottom Theme Toggle + Collapse Toggle) -->
        <Border Grid.Column="0" 
                x:Name="SidebarBorder"
                Width="220"
                ClipToBounds="True"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sidebar Top Bar with Collapse/Expand Toggle -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="6,3">
                    <Button Command="{Binding ToggleSidebarCommand}"
                            ToolTip="{Binding SidebarToggleButtonToolTip}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="{Binding SidebarToggleAlignment}">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="BtnBorder"
                                        Background="Transparent"
                                        CornerRadius="5"
                                        Padding="6,3">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{Binding SidebarToggleButtonIcon}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                </Border>

                <!-- Sidebar Items List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding SidebarItems}"
                         SelectedItem="{Binding SelectedSidebarItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         PreviewDragOver="OnSidebarPreviewDragOver"
                         PreviewDrop="OnSidebarPreviewDrop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Stretch">
                                <!-- ================= HEADER ITEM ================= -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <!-- Expanded Header: Text Label ("FAVORITES" / "DRIVES") -->
                                    <TextBlock Text="{Binding Name}" 
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" 
                                               FontWeight="Bold" 
                                               Margin="4,8,0,2">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarMinimized, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Minimized Header: Icon matching the word ("FAVORITES" -> Star, "DRIVES" -> Drive) -->
                                    <Grid HorizontalAlignment="Center" Margin="0,8,0,4">
                                        <Grid.Style>
                                            <Style TargetType="{x:Type Grid}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarMinimized, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <!-- Favorites Icon (Star) -->
                                        <Path Width="14" Height="14" 
                                              Stretch="Uniform" 
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              ToolTip="Favorites"
                                              Data="M 12 2 L 15.09 8.26 L 22 9.27 L 17 14.14 L 18.18 21.02 L 12 17.77 L 5.82 21.02 L 7 14.14 L 2 9.27 L 8.91 8.26 Z">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HeaderType}" Value="FAVORITES">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>

                                        <!-- Drives Icon (Drive / Storage Disk) -->
                                        <Path Width="15" Height="15" 
                                              Stretch="Uniform" 
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              ToolTip="Drives"
                                              Data="M 3 4 C 3 2.9 3.9 2 5 2 L 19 2 C 20.1 2 21 2.9 21 4 L 21 20 C 21 21.1 20.1 22 19 22 L 5 22 C 3.9 22 3 21.1 3 20 Z M 5 4 L 5 13 L 19 13 L 19 4 Z M 5 15 L 5 20 L 19 20 L 19 15 Z M 16.5 17.5 C 16.5 16.95 16.95 16.5 17.5 16.5 C 18.05 16.5 18.5 16.95 18.5 17.5 C 18.5 18.05 18.05 18.5 17.5 18.5 C 16.95 18.5 16.5 18.05 16.5 17.5 Z M 7 17.5 L 13.5 17.5 L 13.5 18 L 7 18 Z">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HeaderType}" Value="DRIVES">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Grid>

                                <!-- ================= REGULAR FOLDER / DRIVE ITEM ================= -->
                                <Grid ToolTip="{Binding Name}">
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon: centered in compact mode, or leading in expanded mode -->
                                    <Image Grid.Column="0" 
                                           Source="{Binding Icon}" 
                                           Width="16" Height="16" 
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center" />

                                    <!-- Name Text: only visible when NOT minimized -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Name}" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               FontSize="12.5" 
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="10,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarMinimized, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Theme Toggle Button at Bottom of Sidebar -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="4,6">
                    <Button Command="{Binding ToggleThemeCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="BtnBorder"
                                        Background="Transparent"
                                        CornerRadius="5"
                                        Padding="6,6">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Theme Icon: Moon for Dark Mode (Golden luminous moon), Sun for Light Mode (Warm golden sun) -->
                            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16" Opacity="0.85">
                                <!-- Moon icon: visible in Dark Mode -->
                                <Path Width="14" Height="14"
                                      Stretch="Uniform"
                                      Fill="#FFD60A"
                                      Opacity="0.9"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Data="M 9.37 5.51 C 9.19 6.15 9.1 6.82 9.1 7.5 C 9.1 11.64 12.46 15 16.6 15 C 17.28 15 17.95 14.91 18.59 14.73 C 17.36 17.85 14.34 20 10.8 20 C 6.16 20 2.4 16.24 2.4 11.6 C 2.4 8.06 4.55 5.04 7.67 3.81 C 8.19 4.41 8.76 4.98 9.37 5.51 Z">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>

                                <!-- Sun icon: visible in Light Mode -->
                                <Path Width="15" Height="15"
                                      Stretch="Uniform"
                                      Fill="#FF9500"
                                      Opacity="0.9"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Data="M 12 7 C 9.24 7 7 9.24 7 12 C 7 14.76 9.24 17 12 17 C 14.76 17 17 14.76 17 12 C 17 9.24 14.76 7 12 7 Z M 12 2 C 12.55 2 13 2.45 13 3 L 13 5 C 13 5.55 12.55 6 12 6 C 11.45 6 11 5.55 11 5 L 11 3 C 11 2.45 11.45 2 12 2 Z M 12 18 C 12.55 18 13 18.45 13 19 L 13 21 C 13 21.55 12.55 22 12 22 C 11.45 22 11 21.55 11 21 L 11 19 C 11 18.45 11.45 18 12 18 Z M 22 12 C 22 12.55 21.55 13 21 13 L 19 13 C 18.45 13 18 12.55 18 12 C 18 11.45 18.45 11 19 11 L 21 11 C 21.55 11 22 11.45 22 12 Z M 6 12 C 6 12.55 5.55 13 5 13 L 3 13 C 2.45 13 2 12.55 2 12 C 2 11.45 2.45 11 3 11 L 5 11 C 5.55 11 6 11.45 6 12 Z M 19.07 4.93 C 19.46 5.32 19.46 5.95 19.07 6.34 L 17.66 7.76 C 17.27 8.15 16.63 8.15 16.24 7.76 C 15.85 7.37 15.85 6.73 16.24 6.34 L 17.66 4.93 C 18.05 4.54 18.68 4.54 19.07 4.93 Z M 7.76 16.24 C 8.15 16.63 8.15 17.27 7.76 17.66 L 6.34 19.07 C 5.95 19.46 5.32 19.46 4.93 19.07 C 4.54 18.68 4.54 18.05 4.93 17.66 L 6.34 16.24 C 6.73 15.85 7.37 15.85 7.76 16.24 Z M 19.07 19.07 C 18.68 19.46 18.05 19.46 17.66 19.07 L 16.24 17.66 C 15.85 17.27 15.85 16.63 16.24 16.24 C 16.63 15.85 17.27 15.85 17.66 16.24 L 19.07 17.66 C 19.46 18.05 19.46 18.68 19.07 19.07 Z M 7.76 7.76 C 7.37 8.15 6.73 8.15 6.34 7.76 L 4.93 6.34 C 4.54 5.95 4.54 5.32 4.93 4.93 C 5.32 4.54 5.95 4.54 6.34 4.93 L 7.76 6.34 C 8.15 6.73 8.15 7.37 7.76 7.76 Z">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding ThemeButtonText}" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       FontSize="12" 
                                       FontWeight="Medium" 
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarMinimized}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Miller Columns View Container -->
        <ScrollViewer Grid.Column="1" 
                      x:Name="ColumnsScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Background="{DynamicResource WindowBackgroundBrush}">
            <!-- Wrap ItemsControl + scroll-pad in a horizontal StackPanel so the
                 pad border keeps ScrollableWidth alive during backward animation. -->
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ColumnViewModel}">
                            <!-- Single Column (260px Width) -->
                            <Border Width="260" 
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="0,0,1,0" 
                                    Background="{DynamicResource ColumnBackgroundBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Column Header -->
                                    <Border Grid.Row="0" 
                                            Background="{DynamicResource WindowBackgroundBrush}" 
                                            BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="12,0">
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HeaderName}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" 
                                                       VerticalAlignment="Center" />

                                            <TextBlock Text="Loading..." 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                                       FontSize="10" 
                                                       FontStyle="Italic"
                                                       HorizontalAlignment="Right" 
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <!-- Virtualized List of Items with Rubberband Marquee Selection -->
                                    <Grid Grid.Row="1" ClipToBounds="True">
                                        <ListBox x:Name="ColumnListBox"
                                                 ItemsSource="{Binding Items}"
                                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                                 SelectionMode="Extended"
                                                 SelectionChanged="OnColumnListBoxSelectionChanged"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource ColumnListBoxItemStyle}"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 AllowDrop="True"
                                                 PreviewDragOver="OnColumnPreviewDragOver"
                                                 PreviewDrop="OnColumnPreviewDrop"
                                                 PreviewMouseLeftButtonDown="OnColumnListBoxPreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="OnColumnListBoxPreviewMouseMove"
                                                 PreviewMouseLeftButtonUp="OnColumnListBoxPreviewMouseLeftButtonUp"
                                                 PreviewMouseRightButtonDown="OnColumnListBoxPreviewMouseRightButtonDown"
                                                 PreviewMouseRightButtonUp="OnColumnListBoxPreviewMouseRightButtonUp">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                                    <Grid Background="Transparent">
                                                        <!-- Mouse Double-click to open file -->
                                                        <Grid.InputBindings>
                                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                                          Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}" />
                                                        </Grid.InputBindings>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Icon -->
                                                        <Image Grid.Column="0" 
                                                               Source="{Binding Icon}" 
                                                               Width="16" Height="16" 
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,8,0" />

                                                        <!-- File / Folder Name Only -->
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding Name}" 
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                   FontSize="12.5" 
                                                                   HorizontalAlignment="Left"
                                                                   TextTrimming="CharacterEllipsis" 
                                                                   VerticalAlignment="Center" />

                                                        <!-- Folder Chevron indicator (macOS style) -->
                                                        <TextBlock Grid.Column="2" 
                                                                   Text="›" 
                                                                   FontSize="14" 
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                                   VerticalAlignment="Center" 
                                                                   Margin="4,0,2,0"
                                                                   Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Blue Marquee Rubberband Selection Overlay -->
                                        <Canvas IsHitTestVisible="False">
                                            <Border x:Name="RubberBandBox"
                                                    BorderBrush="#0078D7"
                                                    BorderThickness="1"
                                                    Background="#330078D7"
                                                    CornerRadius="1"
                                                    Visibility="Collapsed" />
                                        </Canvas>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Scroll-pad: keeps ScrollableWidth alive during backward animation.
                     Width is set in ViewModel before columns are removed, cleared after anim. -->
                <Border Width="{Binding ScrollPadWidth}" Background="Transparent" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
