<Window x:Class="ContextMenuManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ContextMenuManager.Models"
        Title="Context Menu Manager"
        Icon="app.ico"
        Height="740" Width="1060"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0B1120"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        Activated="Window_Activated">

    <Window.Resources>
        <!-- Theme Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#0B1120"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#334155"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentBlueHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBlueHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success Green Button -->
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#059669"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Red Button -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Item Style -->
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="false" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Fill="#94A3B8" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="12,7,26,7" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Margin="0,3,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid / ListView -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#1E293B"/>
            <Setter Property="AlternatingRowBackground" Value="#162032"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2D3748"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Padding" Value="0,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Tab Control with Top Bar (Tabs on Left, Explorer & Exit Buttons on Right) -->
        <TabControl Background="Transparent" BorderThickness="0" Margin="16,12,16,12">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Row with Tabs on Left and Header Actions on Right -->
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TabPanel Grid.Column="0" IsItemsHost="True" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="❌ Exit" Style="{StaticResource DangerBtn}" Padding="14,7" Click="BtnExit_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Content Presenter for Selected Tab -->
                        <Border Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#1E293B" CornerRadius="8,8,0,0" Margin="0,0,6,0" Padding="18,10">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      ContentSource="Header" RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Custom Tools Submenu -->
            <TabItem Header="⚡ Custom Cascading Menu">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Submenu Header Bar (Compact) -->
                    <Border Grid.Row="0" Background="#131D31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Menu Display Title -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Menu Display Title:" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtCustomMenuTitle" Width="200" Style="{StaticResource SearchBox}" Text="Custom Tools" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Actions & Backup Checkbox -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkCreateBackupOnDeploy" Content="Create Snapshot Backup" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="If checked, creates a restore point snapshot before deploying"/>
                                <Button Content="🚀 Apply &amp; Deploy to Windows" Style="{StaticResource SuccessBtn}" Margin="0,0,8,0" Click="BtnDeployCascade_Click"/>
                                <Button Content="➕ Add Tool Command" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="BtnAddCustomTool_Click"/>
                                <Button x:Name="BtnToggleEntireMenu" Content="⚡ Disable Menu" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnToggleEntireMenu_Click" ToolTip="Enable or disable the Custom Tools cascading menu in Windows context menu"/>
                                <Button Content="🔄 Refresh" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnRefreshCustomTools_Click" ToolTip="Reload custom tools and check registry status"/>
                                <Button Content="❌ Remove Menu" Style="{StaticResource DangerBtn}" Click="BtnRemoveCascade_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tools Grid & Visual Preview -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="290"/>
                        </Grid.ColumnDefinitions>

                        <!-- Custom Tools Grid (Multi-select enabled, IsReadOnly prevents edit crash) -->
                        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Configured Submenu Commands" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8" Margin="4,0,0,8"/>

                                <DataGrid x:Name="GridCustomTools" Grid.Row="1" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="GridCustomTools_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Command (Display Name)" Binding="{Binding Command}" Width="*"/>
                                        <DataGridTextColumn Header="Execution Mode" Binding="{Binding ExecutionModeDisplay}" Width="240"/>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding TargetDisplay}" Width="190"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="95"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                                    <Button Content="▲ Move Up" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnMoveToolUp_Click"/>
                                    <Button Content="▼ Move Down" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnMoveToolDown_Click"/>
                                    <Button Content="⚡ Toggle State" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnToggleTool_Click"/>
                                    <Button Content="✏️ Edit Tool" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnEditCustomTool_Click"/>
                                    <Button Content="🗑️ Delete Tool" Style="{StaticResource DangerBtn}" Click="BtnDeleteCustomTool_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Visual Explorer Simulation Preview -->
                        <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Live Preview Simulation" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                <TextBlock Text="How your context menu appears in Windows Explorer:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,12"/>

                                <!-- Simulated Right-Click Menu -->
                                <Border Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="6" Padding="4">
                                    <StackPanel>
                                        <Border Padding="10,6" Background="Transparent">
                                            <TextBlock Text="View" Foreground="#CCCCCC" FontSize="12"/>
                                        </Border>
                                        <Border Padding="10,6" Background="Transparent">
                                            <TextBlock Text="Sort by" Foreground="#CCCCCC" FontSize="12"/>
                                        </Border>
                                        <Border Padding="10,6" Background="Transparent">
                                            <TextBlock Text="Refresh" Foreground="#CCCCCC" FontSize="12"/>
                                        </Border>
                                        <Separator Background="#383838" Margin="6,2"/>

                                        <!-- Highlighted Custom Cascade Item -->
                                        <Border Background="#0078D7" CornerRadius="4" Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtPreviewMenuName" Text="Custom Tools" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="▶" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Cascading Children -->
                                        <Border Background="#282828" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Margin="14,4,0,0" Padding="4">
                                            <ItemsControl x:Name="ListPreviewChildren">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8,4" Background="Transparent">
                                                            <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontSize="11"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <Separator Background="#383838" Margin="6,2"/>
                                        <Border Padding="10,6" Background="Transparent">
                                            <TextBlock Text="Properties" Foreground="#CCCCCC" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Restore Points & Backups -->
            <TabItem Header="🛡️ Restore Points &amp; Backups">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar (Buttons Only) -->
                    <Border Grid.Row="0" Background="#131D31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📸 Create Restore Point" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="BtnCreateRestorePoint_Click"/>
                            <Button Content="📌 Pin / Unpin" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnTogglePin_Click" ToolTip="Pin or unpin selected snapshot to keep it at the top of the list"/>
                            <Button Content="⏪ Restore Selected Point" Style="{StaticResource SuccessBtn}" Margin="0,0,8,0" Click="BtnRestoreSelected_Click"/>
                            <Button Content="🗑️ Delete Snapshot" Style="{StaticResource DangerBtn}" Margin="0,0,8,0" Click="BtnDeleteRestorePoint_Click"/>
                            <Button Content="🔄 Refresh" Style="{StaticResource SecondaryBtn}" Click="BtnRefreshRestorePoints_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Restore Points Grid (Multi-select enabled, IsReadOnly prevents edit crash) -->
                    <DataGrid x:Name="GridRestorePoints" Grid.Row="1" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="GridRestorePoints_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pin" Binding="{Binding PinBadge}" Width="95"/>
                            <DataGridTextColumn Header="Snapshot Name" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Created Date &amp; Time" Binding="{Binding FormattedDate}" Width="190"/>
                            <DataGridTextColumn Header="Items Backed Up" Binding="{Binding ItemCount}" Width="120"/>
                            <DataGridTextColumn Header="Description / Note" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
